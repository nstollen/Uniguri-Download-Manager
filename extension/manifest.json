{
  "manifest_version": 3,
  "name": "Uniguri Download Manager",
  "version": "2.0",
  "key": "",
  "description": "Download manager: hands browser downloads and detected videos to the local UDM downloader.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "cookies",
    "nativeMessaging",
    "webRequest",
    "storage",
    "notifications",
    "contextMenus",
    "alarms",
    "offscreen",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "UDM: videos and downloads",
    "default_popup": "popup.html"
  }
}
